# apps/hub — every variable this app reads.
#
# Copy to .env.local for development. .env.local is gitignored; this file is
# the committed list and must never hold a real value.
#
# Nothing here is needed to build. Every page reads the session cookie before
# it queries anything, which makes each route render per request, so `next
# build` never opens a connection. A missing variable fails at the first
# request instead — loudly, which is the point.

# ── The shared session ─────────────────────────────────────────────
#
# Signs the risansi_session JWT. Every portal will verify with this same
# secret once Phase 3 lands, so rotating it signs everyone out everywhere.
#
# Required, at least 32 characters, and there is deliberately no default: the
# sales portal's NextAuth config carries `?? 'risansi-dev-secret-2026'`, which
# means a deploy that forgets the variable still boots and hands out tokens
# signed with a secret that is in the repository. @risansi/identity throws
# rather than do that.
#
#   openssl rand -base64 48
RISANSI_SESSION_SECRET=

# The domain the session cookie is scoped to.
#
# `.risansi.com` in production — with the leading dot — so sales.risansi.com,
# rndtesting.risansi.com and the rest all see one sign-in. That also means any
# subdomain of risansi.com can read it, which is why nothing untrusted may ever
# be hosted on one (MIGRATION_PLAN.md §3).
#
# LEAVE IT EMPTY for localhost and for a Vercel preview deployment: a cookie
# scoped to .risansi.com would simply never be sent on vercel.app, and the
# session would appear not to work at all.
RISANSI_COOKIE_DOMAIN=

# ── The identity database ──────────────────────────────────────────
#
# Its own database, not the sales one (MIGRATION_PLAN.md §2.6). No app
# foreign-keys into it; the link is a column.
#
# Schema: migrations/identity/0001_identity.sql and 0002_app_roles.sql.
IDENTITY_DB_HOST=
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=

# Escape hatch for a local proxy with a self-signed certificate. Set to 1 and
# the server certificate is no longer verified, which leaves the connection
# open to a man-in-the-middle. Never set it in production. Azure Postgres
# chains to a publicly-trusted root, so the default needs no custom CA.
# IDENTITY_DB_SSL_INSECURE=

# ── Email (Resend) ─────────────────────────────────────────────────
#
# Used by @risansi/notify for the three access-flow emails and the daily
# backlog sweep. Leave RESEND_API_KEY unset in development: the package logs a
# warning, skips the send and everything else still works, so nobody needs a
# live key to click through an approval.
RESEND_API_KEY=

# Optional. Defaults to "Risansi Digital <digital-portal@digital.risansi.com>".
#
# Deliberately not no-reply@. That address was accepted by Resend and filed
# out of the inbox by Microsoft every time: new local part, no sending history
# to the tenant, and "no-reply" is a spam signal on its own. digital-portal@
# mirrors sales-portal@digital.risansi.com, which already lands.
#
# The From domain has to be one verified with Resend. `digital.risansi.com` is;
# bare `risansi.com` is a different, unverified domain and Resend answers 403 —
# that trap is recorded in apps/sales/lib/risansi-email.ts and cost somebody an
# afternoon once already.
RESEND_FROM_DIGITAL=

# Optional. Where a reply goes, if you want replies to reach a person rather
# than the no-reply mailbox.
RESEND_REPLY_TO=

# Where the hub lives, used for the button in every email (hubUrl() in the
# notify package). Defaults to https://digital.risansi.com, so production
# works either way — but set it in preview and development or the buttons in
# a test email point at production.
HUB_URL=

# ── The daily cron ─────────────────────────────────────────────────
#
# Vercel sends `Authorization: Bearer $CRON_SECRET` on a scheduled invocation,
# and /api/cron/pending-requests requires it. Set it in every Vercel
# environment, Preview included, or the cron gets a 401.
#
# When it is unset the route is open OUTSIDE production only, so it can be run
# by hand locally. In production a missing secret fails closed.
#
# Schedule lives in apps/hub/vercel.json: `0 2 * * *`, which is 02:00 UTC and
# so 07:30 IST. Vercel cron expressions are always UTC.
CRON_SECRET=
